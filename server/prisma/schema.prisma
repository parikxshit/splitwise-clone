generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Users        ← no dependencies
// 2. Groups       ← needs Users
// 3. GroupMembers ← needs Users + Groups
// 4. Expenses     ← needs Users + Groups
// 5. ExpenseSplits← needs Users + Expenses
// 6. Settlements  ← needs Users + Groups


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships (Reverse side)
  createdGroups       Group[]        @relation("GroupCreator")
  groupMemberships    GroupMember[]
  paidExpenses        Expense[]      @relation("ExpensePayer")
  expenseSplits       ExpenseSplit[]
  sentSettlements     Settlement[]   @relation("SettlementSender")
  receivedSettlements Settlement[]   @relation("SettlementReceiver")
}

// 2. Groups
model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A group is created by one user
  createdBy   String
  creator     User     @relation("GroupCreator", fields: [createdBy], references: [id])

  // Relationships
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
}

// 3. GroupMembers (Pivot table connecting Users and Groups)
model GroupMember {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Ensures a user cannot be added to the same group twice
  @@unique([userId, groupId])
}

// 4. Expense
model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  groupId     String
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  payerId     String
  payer       User     @relation("ExpensePayer", fields: [payerId], references: [id])

  splits      ExpenseSplit[]
}

// 5. ExpenseSplits (How the expense is divided among users)
model ExpenseSplit {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)

  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 6. Settlements (When users pay each other back)
model Settlement {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  senderId    String
  sender      User     @relation("SettlementSender", fields: [senderId], references: [id])

  receiverId  String
  receiver    User     @relation("SettlementReceiver", fields: [receiverId], references: [id])

  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
}
